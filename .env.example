# ==============================================================================
# MadVerse — Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'production')
NODE_ENV=production

# Server Port (Render & Railway inject this automatically; defaults to 3001 locally or 8080 in Docker)
PORT=3001

# Secret key used for signing and verifying Admin JWT authentication tokens
# In production, replace with a strong, random 64-character secret
JWT_SECRET=replace_with_a_secure_random_production_secret_key_123456789

# Optional: Google Gemini API Key for dynamic AI review generation
# If left empty, MadVerse automatically falls back to its 63 handcrafted rating-specific reviews
GEMINI_API_KEY=

# Optional: Public URL of the deployed application (e.g. https://madverse.onrender.com)
# Used for generating full QR code review URLs. If omitted, it dynamically resolves from request headers
BASE_URL=
